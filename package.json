{
  "name": "boxhead",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "extract": "npm run -w @boxhead/extract start --",
    "dev": "npm run -w @boxhead/client dev",
    "build": "npm run -w @boxhead/shared build && npm run -w @boxhead/client build",
    "server": "npm run -w @boxhead/server start",
    "start": "npm run -w @boxhead/server start",
    "build:single": "npm run -w @boxhead/client build:single",
    "typecheck": "tsc -b",
    "pretest": "tsc -b",
    "test": "node --import tsx --test \"packages/**/test/*.test.ts\"",
    "bench": "tsx packages/shared/test/bench.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "tsx": "^4.19.2"
  }
}
